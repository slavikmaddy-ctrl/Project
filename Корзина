            { id: 8, name: "EMPIRE Шапка Бини Чёрная", price: 20, image: "https://a.lmcdn.ru/product/M/P/MP002XU016PH_31077361_5_v2_2x.jpg", category: "accessories" },
            { id: 9, name: "EMPIRE Винил Wizkid 'Real'", price: 35, image: "https://i.ytimg.com/vi/sCBNlK2HVww/maxresdefault.jpg", category: "music" },
            { id: 10, name: "EMPIRE CD Бандл", price: 50, image: "https://cdn1.ozone.ru/s3/multimedia-1-b/7102006643.jpg", category: "music" },
            { id: 11, name: "EMPIRE x New Era Чёрный Снепбек", price: 45, image: "https://a.lmcdn.ru/img600x866/M/P/MP002XM09LV9_15739750_9_v1_2x.jpg", category: "accessories" },
            { id: 12, name: "EMPIRE Носки 3 пары", price: 25, image: "https://n.cdn.cdek.shopping/images/shopping/inEZKdAIiwEqOtiO.jpg?v=1", category: "accessories" }
        ];

        const rentalPeriods = [
            { label: "1 день", days: 1, discount: 0 },
            { label: "3 дня", days: 3, discount: 0.10 },
            { label: "7 дней", days: 7, discount: 0.20 },
            { label: "14 дней", days: 14, discount: 0.30 },
            { label: "30 дней", days: 30, discount: 0.35 }
        ];

        let cart = JSON.parse(localStorage.getItem('empire_cart') || '[]');
        let emPointsUsed = 0;
        let emDiscountApplied = 0;

        function initDemoCart() {
            if (cart.length === 0) {
                cart = [
                    { id: 2, quantity: 1, period: 1 },
                    { id: 9, quantity: 1, period: 2 },
                    { id: 8, quantity: 2, period: 0 }
                ];
                saveCart();
            }
        }

        function saveCart() {
            localStorage.setItem('empire_cart', JSON.stringify(cart));
            updateCartCount();
        }

        function updateCartCount() {
            const total = cart.reduce((sum, item) => sum + item.quantity, 0);
            document.getElementById('cart-count').textContent = total;
        }

        function renderCart() {
            const container = document.getElementById('cart-items');
            const emptyState = document.getElementById('cart-empty');

            if (cart.length === 0) {
                container.innerHTML = '';
                emptyState.classList.remove('hidden');
                updateSummary();
                return;
            }

            emptyState.classList.add('hidden');

            container.innerHTML = cart.map((item, index) => {
                const product = products.find(p => p.id === item.id);
                if (!product) return '';
                const period = rentalPeriods[item.period];
                const baseTotal = product.price * period.days * item.quantity;
                const discount = baseTotal * period.discount;
                const finalPrice = baseTotal - discount;

                return `
                    <div class="cart-item fade-in" data-index="${index}">
                        <div class="w-24 h-24 flex-shrink-0 rounded-lg overflow-hidden bg-gray-100">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover"
                                 onerror="this.src='https://via.placeholder.com/96x96/f3f4f6/000000?text=EMPIRE'">
                        </div>
                        
                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-start mb-2">
                                <h3 class="font-semibold text-sm truncate pr-4">${product.name}</h3>
                                <button class="remove-btn" onclick="removeItem(${index})" title="Удалить">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </div>
                            
                            <p class="text-gray-500 text-sm mb-3">$${product.price} / день</p>
                            
                            <div class="mb-3">
                                <label class="text-xs text-gray-400 uppercase tracking-wider font-medium">Срок аренды</label>
                                <select class="rental-select w-full mt-1 px-3 py-2 rounded-lg border border-gray-200 text-sm font-medium focus:border-black focus:outline-none bg-white"
                                        onchange="changePeriod(${index}, this.value)">
                                    ${rentalPeriods.map((p, i) => `
                                        <option value="${i}" ${i === item.period ? 'selected' : ''}>
                                            ${p.label} — $${Math.round(product.price * p.days * (1 - p.discount))}
                                            ${p.discount > 0 ? ` (экономия ${Math.round(p.discount * 100)}%)` : ''}
                                        </option>
                                    `).join('')}
                                </select>
                            </div>
                            
                            <div class="flex justify-between items-center">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-gray-400 uppercase tracking-wider font-medium mr-2">Кол-во</span>
                                    <button class="qty-btn" onclick="changeQty(${index}, -1)">−</button>
                                    <span class="qty-value">${item.quantity}</span>
                                    <button class="qty-btn" onclick="changeQty(${index}, 1)">+</button>
                                </div>
                                
                                <div class="text-right">
                                    ${period.discount > 0 ? `<div class="text-xs text-gray-400 line-through">$${baseTotal.toFixed(2)}</div>` : ''}
                                    <div class="font-bold text-lg">$${finalPrice.toFixed(2)}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            updateSummary();
        }

        window.changeQty = (index, delta) => {
            cart[index].quantity = Math.max(1, cart[index].quantity + delta);
            saveCart();
            renderCart();
        };

        window.changePeriod = (index, periodIndex) => {
            cart[index].period = parseInt(periodIndex);
            saveCart();
            renderCart();
            showToast('Срок аренды обновлён', 'success');
        };

        window.removeItem = (index) => {
            const item = document.querySelector(`[data-index="${index}"]`);
            item.classList.add('slide-out');
            setTimeout(() => {
                cart.splice(index, 1);
                saveCart();
                renderCart();
                showToast('Товар удалён из корзины', 'success');
            }, 400);
        };

        function updateSummary() {
            let subtotal = 0;
            let totalDiscount = 0;

            cart.forEach(item => {
                const product = products.find(p => p.id === item.id);
                if (!product) return;
                const period = rentalPeriods[item.period];
                const base = product.price * period.days * item.quantity;
                subtotal += base;
                totalDiscount += base * period.discount;
            });

            const tax = subtotal * 0.10;
            let total = subtotal + tax - totalDiscount - emDiscountApplied;
            if (total < 0) total = 0;

            document.getElementById('cart-subtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('cart-tax').textContent = `$${tax.toFixed(2)}`;
            document.getElementById('cart-total').textContent = `$${total.toFixed(2)}`;

            const discountRow = document.getElementById('discount-row');
            if (emDiscountApplied > 0) {
                discountRow.classList.remove('hidden');
                document.getElementById('cart-discount').textContent = `-$${emDiscountApplied.toFixed(2)}`;
            } else {
                discountRow.classList.add('hidden');
            }

            // Update EM Points
            updateEMPoints(subtotal + tax - totalDiscount);
        }

        function getEMPoints() {
            return JSON.parse(localStorage.getItem('empire_em_points') || '{"balance": 500, "totalEarned": 500, "totalSpent": 0, "history": []}');
        }

        function saveEMPoints(points) {
            localStorage.setItem('empire_em_points', JSON.stringify(points));
            document.querySelectorAll('.em-balance').forEach(el => el.textContent = points.balance);
        }

        function updateEMPoints(orderTotal) {
            const points = getEMPoints();
            document.querySelectorAll('.em-balance').forEach(el => el.textContent = points.balance);

            const maxDiscount = orderTotal * 0.5;
            const maxPoints = Math.min(points.balance, Math.ceil(maxDiscount * 10));

            const slider = document.getElementById('em-slider');
            const input = document.getElementById('em-input');
            
            slider.max = maxPoints;
            input.max = maxPoints;
            
            if (parseInt(slider.value) > maxPoints) {
                slider.value = maxPoints;
                input.value = maxPoints;
            }

            updateEMDiscount();
        }

        function updateEMDiscount() {
            const slider = document.getElementById('em-slider');
            const input = document.getElementById('em-input');
            const points = parseInt(slider.value) || 0;
            const discount = points / 10;

            input.value = points;
            document.getElementById('em-discount').textContent = `-$${discount.toFixed(2)}`;

            let subtotal = 0;
            let totalDiscount = 0;
            cart.forEach(item => {
                const product = products.find(p => p.id === item.id);
                if (!product) return;
                const period = rentalPeriods[item.period];
                const base = product.price * period.days * item.quantity;
                subtotal += base;
                totalDiscount += base * period.discount;
            });
            const tax = subtotal * 0.10;
            const total = Math.max(0, subtotal + tax - totalDiscount - discount);
            
            document.getElementById('em-final-total').textContent = `$${total.toFixed(2)}`;
            
            return { points, discount };
        }

        document.getElementById('em-slider').addEventListener('input', updateEMDiscount);
        document.getElementById('em-input').addEventListener('change', function() {
            let val = parseInt(this.value) || 0;
            const slider = document.getElementById('em-slider');
            val = Math.max(0, Math.min(val, slider.max));
            slider.value = val;
            updateEMDiscount();
        });

        document.getElementById('apply-em-btn').addEventListener('click', function() {
            const { points, discount } = updateEMDiscount();
            if (points > 0) {
                const emPoints = getEMPoints();
                if (emPoints.balance >= points) {
                    emPoints.balance -= points;
                    emPoints.totalSpent += points;
                    emPoints.history.push({
                        type: 'spend', amount: points, reason: 'Скидка на заказ',
                        date: new Date().toISOString()
                    });
                    saveEMPoints(emPoints);
                    emPointsUsed = points;
                    emDiscountApplied = discount;
                    updateSummary();
                    this.disabled = true;
                    this.textContent = 'Применено ✓';
                    this.classList.add('bg-green-600');
                    showToast(`Скидка $${discount.toFixed(2)} применена!`, 'success');
                } else {
                    showToast('Недостаточно баллов', 'error');
                }
            }
        });

        document.getElementById('checkout-btn').addEventListener('click', function() {
            if (cart.length === 0) {
                showToast('Корзина пуста', 'error');
                return;
            }
            this.disabled = true;
            this.textContent = 'Оформление...';
            setTimeout(() => {
                showToast('Заказ оформлен! Перенаправление...', 'success');
                setTimeout(() => {
                    const emPoints = getEMPoints();
                    const earned = Math.floor(cart.reduce((sum, item) => {
                        const product = products.find(p => p.id === item.id);
                        const period = rentalPeriods[item.period];
                        return sum + (product.price * period.days * item.quantity * (1 - period.discount));
                    }, 0) * 0.1);
                    emPoints.balance += earned;
                    emPoints.totalEarned += earned;
                    emPoints.history.push({
                        type: 'earn', amount: earned, reason: 'Заказ в корзине',
                        date: new Date().toISOString()
                    });
                    saveEMPoints(emPoints);
                    
                    cart = [];
                    saveCart();
                    renderCart();
                    this.disabled = false;
                    this.textContent = 'Оформить заказ';
                }, 1500);
            }, 1000);
        });

        const searchOverlay = document.getElementById('search-overlay');
        document.getElementById('search-btn').addEventListener('click', () => {
            searchOverlay.classList.add('active');
            document.getElementById('search-input').focus();
        });
        document.getElementById('close-search').addEventListener('click', () => {
            searchOverlay.classList.remove('active');
        });
        document.getElementById('search-input').addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase();
            const results = document.getElementById('search-results');
            if (!query) { results.innerHTML = ''; return; }
            const found = products.filter(p => p.name.toLowerCase().includes(query));
            results.innerHTML = found.length ? found.map(p => `

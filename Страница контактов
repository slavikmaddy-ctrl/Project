function initContactForm() {
    const form = document.getElementById('contact-form');
    if (!form) return;

    const saved = StorageManager.loadContactForm();
    if (saved) {
        Object.keys(saved).forEach(key => {
            const input = form.querySelector(`[name="${key}"]`);
            if (input && key !== 'timestamp') {
                input.value = saved[key];
            }
        });
    }

    form.querySelectorAll('input, select, textarea').forEach(input => {
        input.addEventListener('input', () => {
            const data = {};
            form.querySelectorAll('input, select, textarea').forEach(field => {
                data[field.name] = field.value;
            });
            StorageManager.saveContactForm(data);
        });
    });

    form.addEventListener('submit', (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="btn-spinner"></span>Отправка...';

        setTimeout(() => {
            btn.innerHTML = '✓ Отправлено!';
            btn.style.background = '#16a34a';
            showToast('Сообщение отправлено!', 'success');

            StorageManager.clearContactForm();
            form.reset();

            setTimeout(() => {
                btn.disabled = false;
                btn.textContent = 'Отправить';
                btn.style.background = '';
            }, 2000);
        }, 1500);
    });
}

(function() {
            const form = document.getElementById('contact-form');
            const progressBar = document.getElementById('form-progress-bar');
            const percentText = document.getElementById('form-percent');
            const statusText = document.getElementById('form-status');
            const steps = document.querySelectorAll('.form-progress-step');

            const fields = [
                { name: 'firstName', step: 'name', weight: 20 },
                { name: 'lastName', step: 'name', weight: 15 },
                { name: 'email', step: 'email', weight: 25 },
                { name: 'subject', step: 'subject', weight: 20 },
                { name: 'message', step: 'message', weight: 20 }
            ];

            function updateProgress() {
                let totalProgress = 0;
                const filledSteps = new Set();

                fields.forEach(field => {
                    const input = form.querySelector(`[name="${field.name}"]`);
                    if (input && input.value.trim()) {
                        totalProgress += field.weight;
                        filledSteps.add(field.step);

                        input.classList.add('filled');
                        input.classList.add('just-filled');
                        setTimeout(() => input.classList.remove('just-filled'), 600);
                    } else if (input) {
                        input.classList.remove('filled');
                    }
                });

                progressBar.style.width = totalProgress + '%';
                percentText.textContent = Math.round(totalProgress) + '%';

                if (totalProgress === 100) {
                    percentText.classList.add('complete');
                    statusText.textContent = ' Форма готова к отправке!';
                    statusText.classList.add('complete');
                } else {
                    percentText.classList.remove('complete');
                    const remaining = fields.filter(f => {
                        const input = form.querySelector(`[name="${f.name}"]`);
                        return !input || !input.value.trim();
                    }).length;
                    statusText.textContent = `Осталось заполнить: ${remaining} поля`;
                    statusText.classList.remove('complete');
                }

                steps.forEach(step => {
                    const stepName = step.dataset.step;
                    const stepFields = fields.filter(f => f.step === stepName);
                    const filledFields = stepFields.filter(f => {
                        const input = form.querySelector(`[name="${f.name}"]`);
                        return input && input.value.trim();
                    }).length;

                    step.classList.remove('active', 'complete');
                    if (filledFields === stepFields.length) {
                        step.classList.add('complete');
                    } else if (filledFields > 0) {
                        step.classList.add('active');
                    }
                });

                saveFormData();
            }

            function saveFormData() {
                const data = {};
                fields.forEach(field => {
                    const input = form.querySelector(`[name="${field.name}"]`);
                    if (input) {
                        data[field.name] = input.value;
                    }
                });
                data.progress = parseInt(percentText.textContent);
                localStorage.setItem('empire_contact_form_progress', JSON.stringify(data));
            }

            function loadFormData() {
                const saved = localStorage.getItem('empire_contact_form_progress');
                if (saved) {
                    const data = JSON.parse(saved);
                    fields.forEach(field => {
                        const input = form.querySelector(`[name="${field.name}"]`);
                        if (input && data[field.name]) {
                            input.value = data[field.name];
                        }
                    });
                    updateProgress();
                }
            }

            fields.forEach(field => {
                const input = form.querySelector(`[name="${field.name}"]`);
                if (input) {
                    input.addEventListener('input', updateProgress);
                    input.addEventListener('change', updateProgress);
                    input.addEventListener('focus', () => {
                        steps.forEach(s => s.classList.remove('active'));
                        const step = document.querySelector(`.form-progress-step[data-step="${field.step}"]`);
                        if (step) step.classList.add('active');
                    });
                }
            });

            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const btn = form.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.textContent = 'Отправка...';

                setTimeout(() => {
                    btn.textContent = 'Отправлено!';
                    showToast('Сообщение отправлено!');

                    localStorage.removeItem('empire_contact_form_progress');
                    form.reset();
                    updateProgress();

                    setTimeout(() => {
                        btn.disabled = false;
                        btn.textContent = 'Отправить';
                    }, 2000);
                }, 1500);
            });

            loadFormData();
        })();

        const StorageManager = {
    saveContactForm(data) {
        localStorage.setItem('empire_contact_form', JSON.stringify({
            ...data,
            timestamp: new Date().toISOString()
        }));
    },

    loadContactForm() {
        const saved = localStorage.getItem('empire_contact_form');
        return saved ? JSON.parse(saved) : null;
    },

    clearContactForm() {
        localStorage.removeItem('empire_contact_form');
    }
};

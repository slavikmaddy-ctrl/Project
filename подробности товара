function() {
    const params = new URLSearchParams(window.location.search);
    const itemId = parseInt(params.get('id')) || 2;
    
    initDemoTracking(itemId);
    
    const history = ItemTracking.getHistory(itemId);
    const stats = ItemTracking.getStats(itemId);
    const currentLoc = ItemTracking.getCurrentLocation(itemId);
    const currentCond = ItemTracking.getCurrentCondition(itemId);
    
    document.getElementById('current-location').textContent = currentLoc?.locationName || 'Неизвестно';
    document.getElementById('condition-badge').textContent = currentCond?.conditionLabel || 'Хорошее';
    document.getElementById('condition-badge').style.background = ItemTracking.getConditionBar(currentCond?.condition).color + '40';
    document.getElementById('condition-badge').style.color = ItemTracking.getConditionBar(currentCond?.condition).color;
    
    document.getElementById('stat-rentals').textContent = stats.totalRentals;
    document.getElementById('stat-days').textContent = stats.totalDays;
    document.getElementById('stat-rating').innerHTML = `★ ${stats.avgRating}`;
    
    const popEl = document.getElementById('stat-popularity');
    const popMap = { high: ['Высокая', 'bg-red-100 text-red-700'], medium: ['Средняя', 'bg-yellow-100 text-yellow-700'], low: ['Низкая', 'bg-gray-200 text-gray-600'] };
    const [popText, popClass] = popMap[stats.popularity];
    popEl.textContent = popText;
    popEl.className = `px-2 py-0.5 rounded text-xs font-bold ${popClass}`;
    
    renderTimeline(history);
    
    function initDemoTracking(id) {
        const existing = ItemTracking.getHistory(id);
        if (existing.locations.length > 1) return; // Уже есть данные
        
        const product = store.products.find(p => p.id === id);
        if (!product) return;
        
        ItemTracking.initTracking(id, {
            title: product.name,
            brand: 'EMPIRE',
            category: product.category,
            initialCondition: 'excellent',
            photos: [product.image]
        });
        
        const demoRentals = [
            { days: 3, price: product.price, renter: 'Александр К.', rating: 5, date: '2025-03-15' },
            { days: 7, price: product.price, renter: 'Мария С.', rating: 5, date: '2025-02-20' },
            { days: 1, price: product.price, renter: 'Дмитрий В.', rating: 4, date: '2025-01-10' }
        ];
        
        demoRentals.forEach((r, i) => {
            ItemTracking.addLocation(id, 'storage', { date: r.date, notes: 'Поступила на склад' });
            ItemTracking.addLocation(id, 'rented', { 
                date: r.date, 
                renterName: r.renter,
                notes: `Аренда ${r.days} дней` 
            });
            
            ItemTracking.addRental(id, {
                days: r.days,
                pricePerDay: r.price,
                totalPaid: r.price * r.days,
                renterName: r.renter,
                renterRating: r.rating,
                startDate: r.date,
                endDate: new Date(new Date(r.date).getTime() + r.days * 86400000).toISOString(),
                conditionBefore: 'excellent',
                conditionAfter: 'excellent'
            });
        });
        
        ItemTracking.addLocation(id, 'storage', { notes: 'Возвращена после аренды' });
        ItemTracking.addCondition(id, 'excellent', 'Проверка после 3 аренд', [], 'Екатерина М.');
    }
    
    function renderTimeline(history) {
        const container = document.getElementById('timeline-container');
        const allEvents = [
            ...history.locations.map(l => ({ ...l, icon: getLocationIcon(l.location), color: 'bg-blue-500' })),
            ...history.rentals.map(r => ({ ...r, icon: '🛍️', color: 'bg-green-500', isRental: true })),
            ...history.conditions.map(c => ({ ...c, icon: getConditionIcon(c.condition), color: 'bg-yellow-500' }))
        ].sort((a, b) => new Date(b.date) - new Date(a.date));
        
        const showEvents = allEvents.slice(0, 5);
        
        container.innerHTML = showEvents.map((event, i) => `
            <div class="relative flex gap-4 ${i === 0 ? 'animate-pulse' : ''}">
                <div class="relative z-10 w-8 h-8 rounded-full ${event.color} flex items-center justify-center text-white text-sm shadow-lg">
                    ${event.icon}
                </div>
                <div class="flex-1 pb-6">
                    <div class="flex items-start justify-between mb-1">
                        <div class="font-bold ${event.isRental ? 'text-green-700' : ''}">
                            ${event.isRental ? `Аренда ${event.days} дней` : (event.locationName || event.conditionLabel)}
                        </div>
                        <div class="text-xs text-gray-400">${formatDate(event.date)}</div>
                    </div>
                    <div class="text-sm text-gray-600 mb-1">
                        ${event.notes || (event.isRental ? `Арендатор: ${event.renterName} ★${event.renterRating}` : '')}
                    </div>
                    ${event.isRental ? `
                        <div class="text-sm font-medium text-green-600">
                            +$${Math.round(event.totalPaid * 0.8)} владельцу
                        </div>
                    ` : ''}
                    ${event.inspector ? `
                        <div class="text-xs text-gray-400 mt-1">
                            Проверил: ${event.inspector}
                        </div>
                    ` : ''}
                </div>
            </div>
        `).join('');
        
        if (allEvents.length > 5) {
            document.getElementById('show-more-timeline').classList.remove('hidden');
            document.getElementById('show-more-timeline').onclick = () => {
                container.innerHTML = allEvents.map((event, i) => `
                    <div class="relative flex gap-4">
                        <div class="relative z-10 w-8 h-8 rounded-full ${event.color} flex items-center justify-center text-white text-sm shadow-lg">
                            ${event.icon}
                        </div>
                        <div class="flex-1 pb-6">
                            <div class="flex items-start justify-between mb-1">
                                <div class="font-bold ${event.isRental ? 'text-green-700' : ''}">
                                    ${event.isRental ? `Аренда ${event.days} дней` : (event.locationName || event.conditionLabel)}
                                </div>
                                <div class="text-xs text-gray-400">${formatDate(event.date)}</div>
                            </div>
                            <div class="text-sm text-gray-600">
                                ${event.notes || (event.isRental ? `Арендатор: ${event.renterName} ★${event.renterRating}` : '')}
                            </div>
                        </div>
                    </div>
                `).join('');
                document.getElementById('show-more-timeline').classList.add('hidden');
            };
        }
    }
    
    function formatDate(dateStr) {
        const date = new Date(dateStr);
        const now = new Date();
        const diff = Math.floor((now - date) / 86400000);
        
        if (diff === 0) return 'Сегодня';
        if (diff === 1) return 'Вчера';
        if (diff < 7) return `${diff} дн. назад`;
        if (diff < 30) return `${Math.floor(diff / 7)} нед. назад`;
        
        return date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
    }
})();
function loadProductDetails() {
    const params = new URLSearchParams(window.location.search);
    const id = parseInt(params.get('id')) || 2;

    StorageManager.saveLastViewedProduct(id);

    const product = store.products.find(p => p.id === id) || store.products[1];

    document.title = `${product.name} — EMPIRE`;

    const nameEl = document.getElementById('product-name');
    const priceEl = document.getElementById('product-price');
    const periodEl = document.getElementById('product-period');
    const imageEl = document.getElementById('main-image');
    const addBtn = document.getElementById('add-to-cart-btn');
    const rentalSelect = document.getElementById('rental-period');

    if (nameEl) nameEl.textContent = product.name;
    if (priceEl) priceEl.textContent = `$${product.price}`;
    if (periodEl) periodEl.textContent = `/${product.period}`;
    if (imageEl) {
        imageEl.src = PlaceholderGenerator.generate(800, 800, 'EMPIRE');
        imageEl.setAttribute('data-src', product.image.replace('w=400', 'w=800').replace('h=400', 'h=800'));
        imageEl.width = 800;
        imageEl.height = 800;
        imageEl.onerror = function() { 
            this.onerror = null;
            this.src = PlaceholderGenerator.generateError(800, 800); 
        };
    }

    if (rentalSelect) {
        rentalSelect.innerHTML = store.rentalPeriods.map(p => 
            `<option value="${p}" ${p === product.period ? 'selected' : ''}>${p} — $${calculatePrice(product.price, product.period, p)}</option>`
        ).join('');

        rentalSelect.addEventListener('change', (e) => {
            const newPrice = calculatePrice(product.price, product.period, e.target.value);
            if (priceEl) priceEl.textContent = `$${newPrice}`;
        });
    }

    if (addBtn) {
        addBtn.onclick = () => {
            const size = document.querySelector('.size-btn.active')?.textContent || 'M';
            const colorBtn = document.querySelector('.color-btn.ring-2') || document.querySelector('.color-btn');
            const color = colorBtn?.getAttribute('title') || 'Чёрный';
            const rentalDays = rentalSelect?.value || product.period;
            const finalPrice = calculatePrice(product.price, product.period, rentalDays);

            addToCart(product.id, product.name, finalPrice, rentalDays, product.image, size, color, rentalDays);
        };
    }

    refreshLazyLoading();
}

document.querySelectorAll('.thumb').forEach(thumb => {
    thumb.addEventListener('click', function() {
        document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        
        const mainImage = document.getElementById('main-image');
        if (mainImage) {
            const newSrc = this.getAttribute('data-src');
            if (newSrc) {
                mainImage.style.opacity = '0.5';
                
                const tempImg = new Image();
                tempImg.onload = function() {
                    mainImage.src = newSrc;
                    mainImage.style.opacity = '1';
                };
                tempImg.src = newSrc;
            }
        }
    });
});

document.querySelectorAll('.size-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        localStorage.setItem('empire_last_product_options', JSON.stringify({
            ...JSON.parse(localStorage.getItem('empire_last_product_options') || '{}'),
            size: this.textContent
        }));
    });
});

document.querySelectorAll('.color-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.color-btn').forEach(b => {
            b.classList.remove('ring-2', 'ring-offset-2', 'ring-black');
        });
        this.classList.add('ring-2', 'ring-offset-2', 'ring-black');
        localStorage.setItem('empire_last_product_options', JSON.stringify({
            ...JSON.parse(localStorage.getItem('empire_last_product_options') || '{}'),
            color: this.getAttribute('title')
        }));
    });
});


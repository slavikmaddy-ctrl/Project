        (function() {
            let currentStep = 1;
            const totalSteps = 4;
            
            const form = document.getElementById('rent-form');
            const prevBtn = document.getElementById('prev-btn');
            const nextBtn = document.getElementById('next-btn');
            const submitBtn = document.getElementById('submit-btn');
            const progressBar = document.getElementById('form-progress');
            const stepLabel = document.getElementById('step-label');
            const stepPercent = document.getElementById('step-percent');
            
            const calcPrice = document.getElementById('calc-price');
            const calcCategory = document.getElementById('calc-category');
            const calcDaily = document.getElementById('calc-daily');
            const calcMonthly = document.getElementById('calc-monthly');
            const calcIncome = document.getElementById('calc-income');
            const retailPrice = document.getElementById('retail-price');
            const rentalPrice = document.getElementById('rental-price');
            const suggestedPrice = document.getElementById('suggested-price');
            
            function updateCalculator() {
                const price = parseFloat(calcPrice.value) || 0;
                const category = calcCategory.value;
                
                const rates = {
                    clothing: 0.05,
                    accessories: 0.04,
                    music: 0.03,
                    sneakers: 0.06,
                    bags: 0.04,
                    jewelry: 0.03
                };
                
                const daily = Math.round(price * (rates[category] || 0.05));
                const monthly = daily * 24; // 80% загрузка
                const income = Math.round(monthly * 0.8);
                
                calcDaily.textContent = `$${daily}`;
                calcMonthly.textContent = `$${monthly}`;
                calcIncome.textContent = `$${income}`;
            }
            
            calcPrice?.addEventListener('input', updateCalculator);
            calcCategory?.addEventListener('change', updateCalculator);
            
            retailPrice?.addEventListener('input', (e) => {
                const val = parseFloat(e.target.value) || 0;
                const suggested = Math.round(val * 0.05);
                suggestedPrice.textContent = `$${suggested}`;
                if (!rentalPrice.value) rentalPrice.value = suggested;
            });
            
            function showStep(step) {
                document.querySelectorAll('.form-step').forEach(s => s.classList.add('hidden'));
                document.querySelector(`.form-step[data-step="${step}"]`).classList.remove('hidden');
                
                prevBtn.classList.toggle('hidden', step === 1);
                nextBtn.classList.toggle('hidden', step === totalSteps);
                submitBtn.classList.toggle('hidden', step !== totalSteps);
                
                const percent = (step / totalSteps) * 100;
                progressBar.style.width = `${percent}%`;
                stepLabel.textContent = `Шаг ${step} из ${totalSteps}: ${getStepName(step)}`;
                stepPercent.textContent = `${Math.round(percent)}%`;
                
                currentStep = step;
            }
            
            function getStepName(step) {
                const names = ['', 'Основное', 'Ценообразование', 'Фото', 'Контакты'];
                return names[step];
            }
            
            function validateStep(step) {
                const stepEl = document.querySelector(`.form-step[data-step="${step}"]`);
                const required = stepEl.querySelectorAll('[required]');
                let valid = true;
                
                required.forEach(field => {
                    if (!field.value.trim()) {
                        field.classList.add('input-invalid');
                        valid = false;
                    } else {
                        field.classList.remove('input-invalid');
                    }
                });
                
                if (!valid) showToast('Заполните все обязательные поля', 'error');
                return valid;
            }
            
            nextBtn?.addEventListener('click', () => {
                if (validateStep(currentStep) && currentStep < totalSteps) {
                    showStep(currentStep + 1);
                }
            });
            
            prevBtn?.addEventListener('click', () => {
                if (currentStep > 1) showStep(currentStep - 1);
            });
            
            const dropZone = document.getElementById('drop-zone');
            const photoInput = document.getElementById('photo-input');
            const photoPreview = document.getElementById('photo-preview');
            let uploadedPhotos = [];
            
            dropZone?.addEventListener('click', () => photoInput.click());
            
            dropZone?.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('border-black', 'bg-gray-50');
            });
            
            dropZone?.addEventListener('dragleave', () => {
                dropZone.classList.remove('border-black', 'bg-gray-50');
            });
            
            dropZone?.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('border-black', 'bg-gray-50');
                handleFiles(e.dataTransfer.files);
            });
            
            photoInput?.addEventListener('change', (e) => handleFiles(e.target.files));
            
            function handleFiles(files) {
                Array.from(files).forEach(file => {
                    if (!file.type.startsWith('image/')) return;
                    
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        uploadedPhotos.push(e.target.result);
                        renderPreviews();
                    };
                    reader.readAsDataURL(file);
                });
            }
            
            function renderPreviews() {
                photoPreview.innerHTML = uploadedPhotos.map((src, i) => `
                    <div class="relative aspect-square rounded-lg overflow-hidden">
                        <img src="${src}" class="w-full h-full object-cover">
                        <button type="button" onclick="removePhoto(${i})" class="absolute top-1 right-1 w-6 h-6 bg-black text-white rounded-full text-xs">×</button>
                    </div>
                `).join('');
            }
            
            window.removePhoto = (index) => {
                uploadedPhotos.splice(index, 1);
                renderPreviews();
            };
            
            form?.addEventListener('submit', (e) => {
                e.preventDefault();
                
                const formData = new FormData(form);
                const data = Object.fromEntries(formData);
                data.photos = uploadedPhotos;
                data.status = 'pending';
                data.createdAt = new Date().toISOString();
                data.id = Date.now();
                
                const listings = JSON.parse(localStorage.getItem('empire_listings') || '[]');
                listings.push(data);
                localStorage.setItem('empire_listings', JSON.stringify(listings));
                
                submitBtn.innerHTML = '<span class="btn-spinner"></span>Отправка...';
                
                setTimeout(() => {
                    showToast('Вещь отправлена на модерацию!', 'success');
                    setTimeout(() => {
                        window.location.href = 'dashboard.html';
                    }, 1500);
                }, 1000);
            });
            
            updateCalculator();
        })();


function calculatePrice(basePrice, basePeriod, targetPeriod) {
    const periods = { "1 день": 1, "3 дня": 3, "7 дней": 7, "14 дней": 14, "30 дней": 30 };
    const baseDays = periods[basePeriod] || 1;
    const targetDays = periods[targetPeriod] || 1;

    let multiplier = targetDays / baseDays;
    if (targetDays >= 7) multiplier *= 0.85;
    if (targetDays >= 14) multiplier *= 0.80;
    if (targetDays >= 30) multiplier *= 0.70;

    return Math.round(basePrice * multiplier);
}


const StorageManager = {
    saveListing(listing) {
        const listings = JSON.parse(localStorage.getItem('empire_listings') || '[]');
        listings.push(listing);
        localStorage.setItem('empire_listings', JSON.stringify(listings));
    },

    getListings() {
        return JSON.parse(localStorage.getItem('empire_listings') || '[]');
    }
};

document.getElementById('rent-form')?.addEventListener('submit', (e) => {
    const listings = EMPoints.getPoints().history.filter(h => h.reason === 'listItem');
    if (listings.length === 0) {
        EMPoints.earn(store.emEarnRates.listItem, 'listItem');
    }
});

function approveListing(listingId) {
    EMPoints.earn(store.emEarnRates.itemApproved, 'itemApproved', { listingId });
}


const store = {
    
    simulateRental() {
        const listings = this.getListings().filter(l => l.status === 'approved');
        if (listings.length === 0 || Math.random() > 0.3) return; // 30% шанс
        
        const listing = listings[Math.floor(Math.random() * listings.length)];
        const days = [1, 3, 7][Math.floor(Math.random() * 3)];
        const rental = {
            id: Date.now(),
            listingId: listing.id,
            listingTitle: listing.title,
            days: days,
            total: listing.rentalPrice * days,
            ownerEarnings: Math.round(listing.rentalPrice * days * 0.8),
            date: new Date().toISOString(),
            status: 'completed'
        };
        
        const rentals = JSON.parse(localStorage.getItem('empire_rentals') || '[]');
        rentals.push(rental);
        localStorage.setItem('empire_rentals', JSON.stringify(rentals));
        
        console.log(' Новая аренда:', rental);
    }
};


(function() {
            const listings = JSON.parse(localStorage.getItem('empire_listings') || '[]');
            const rentals = JSON.parse(localStorage.getItem('empire_rentals') || '[]');
            const payouts = JSON.parse(localStorage.getItem('empire_payouts') || '[]');
            
            const active = listings.filter(l => l.status === 'approved').length;
            const totalRentals = rentals.length;
            const totalEarnings = rentals.reduce((sum, r) => sum + (r.ownerEarnings || 0), 0);
            
            document.getElementById('stat-active').textContent = active;
            document.getElementById('stat-rentals').textContent = totalRentals;
            document.getElementById('stat-earnings').textContent = `$${totalEarnings}`;
            document.getElementById('payout-available').textContent = `$${totalEarnings}`;
            
            const listingsGrid = document.getElementById('listings-grid');
            const emptyListings = document.getElementById('empty-listings');
            
            if (listings.length === 0) {
                emptyListings.classList.remove('hidden');
            } else {
                listingsGrid.innerHTML = listings.map(item => `
                    <div class="bg-white rounded-xl overflow-hidden shadow-sm border ${getStatusBorder(item.status)}">
                        <div class="aspect-[4/3] bg-gray-100 relative">
                            ${item.photos?.[0] ? 
                                `<img src="${item.photos[0]}" class="w-full h-full object-cover">` :
                                `<div class="flex items-center justify-center h-full text-gray-400">Нет фото</div>`
                            }
                            <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold uppercase ${getStatusStyle(item.status)}">
                                ${getStatusText(item.status)}
                            </span>
                        </div>
                        <div class="p-4">
                            <h3 class="font-bold mb-1 truncate">${item.title}</h3>
                            <p class="text-gray-500 text-sm mb-3">$${item.rentalPrice}/день</p>
                            <div class="flex gap-2">
                                <button onclick="editListing(${item.id})" class="flex-1 py-2 border rounded-lg text-sm font-medium hover:bg-gray-50">Изменить</button>
                                <button onclick="deleteListing(${item.id})" class="px-3 py-2 border rounded-lg text-red-600 hover:bg-red-50">🗑</button>
                            </div>
                        </div>
                    </div>
                `).join('');
            }
            
            function getStatusBorder(status) {
                const map = {
                    pending: 'border-yellow-200',
                    approved: 'border-green-200',
                    rejected: 'border-red-200'
                };
                return map[status] || 'border-gray-200';
            }
            
            function getStatusStyle(status) {
                const map = {
                    pending: 'bg-yellow-100 text-yellow-800',
                    approved: 'bg-green-100 text-green-800',
                    rejected: 'bg-red-100 text-red-800'
                };
                return map[status] || 'bg-gray-100 text-gray-800';
            }
            
            function getStatusText(status) {
                const map = {
                    pending: 'На проверке',
                    approved: 'Активно',
                    rejected: 'Отклонено'
                };
                return map[status] || status;
            }
            
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.tab-btn').forEach(b => {
                        b.classList.remove('active', 'border-b-2', 'border-black', 'text-black');
                        b.classList.add('text-gray-500');
                    });
                    btn.classList.add('active', 'border-b-2', 'border-black', 'text-black');
                    btn.classList.remove('text-gray-500');
                    
                    document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
                    document.getElementById(`tab-${btn.dataset.tab}`).classList.remove('hidden');
                });
            });
            
            window.editListing = (id) => {
                showToast('Редактирование скоро будет доступно', 'warning');
            };
            
            window.deleteListing = (id) => {
                if (!confirm('Удалить объявление?')) return;
                
                const updated = listings.filter(l => l.id !== id);
                localStorage.setItem('empire_listings', JSON.stringify(updated));
                location.reload();
            };
            
            window.requestPayout = () => {
                if (totalEarnings < 50) {
                    showToast('Минимальная сумма вывода $50', 'error');
                    return;
                }
                showToast('Запрос на вывод отправлен', 'success');
            };
        })();

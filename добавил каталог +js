                ? '<polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon><line x1=\"23\" y1=\"9\" x2=\"17\" y2=\"15\"></line><line x1=\"17\" y1=\"9\" x2=\"23\" y2=\"15\"></line>'
                : '<polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon><path d=\"M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07\"></path>';
        };
        window.toggleVideo = () => {
            video.paused ? video.play() : video.pause();
            document.getElementById('pause-icon').innerHTML = video.paused
                ? '<polygon points=\"5 3 19 12 5 21 5 3\"></polygon>'
                : '<rect x=\"6\" y=\"4\" width=\"4\" height=\"16\"></rect><rect x=\"14\" y=\"4\" width=\"4\" height=\"16\"></rect>';
        };

        function showToast(message, type = '') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => toast.classList.add('show'), 10);
            setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 3000);
        }
        window.showToast = showToast;

        function updateCartCount() {
            const cart = JSON.parse(localStorage.getItem('empire_cart') || '[]');
            document.getElementById('cart-count').textContent = cart.reduce((sum, item) => sum + item.quantity, 0);
        }
        updateCartCount();

        function updateEMBalance() {
            const points = JSON.parse(localStorage.getItem('empire_em_points') || '{"balance": 0}');
            document.querySelectorAll('.em-balance').forEach(el => el.textContent = points.balance);
        }

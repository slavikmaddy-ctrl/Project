function loadArticle() {
    const params = new URLSearchParams(window.location.search);
    const id = parseInt(params.get('id')) || 1;

    const article = store.news.find(n => n.id === id) || store.news[0];

    document.title = `${article.title} — EMPIRE`;

    const titleEl = document.getElementById('article-title');
    const imageEl = document.getElementById('article-image');
    const dateEl = document.getElementById('article-date');
    const categoryEl = document.getElementById('article-category');

    if (titleEl) titleEl.textContent = article.title;
    if (imageEl) {
        imageEl.src = PlaceholderGenerator.generate(1200, 675, 'EMPIRE');
        imageEl.setAttribute('data-src', article.image);
        imageEl.width = 1200;
        imageEl.height = 675;
        imageEl.onerror = function() { 
            this.onerror = null;
            this.src = PlaceholderGenerator.generateError(1200, 675); 
        };
    }
    if (dateEl) dateEl.textContent = article.date;
    if (categoryEl) categoryEl.textContent = article.category;

    refreshLazyLoading();
}


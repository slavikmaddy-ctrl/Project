function renderNews(filter = 'all') {
    const container = document.getElementById('news-grid');
    if (!container) return;

    let news = [...store.news];

    if (filter !== 'all') {
        const filterMap = {
            'new-artists': 'Новый артист',
            'releases': 'Релиз',
            'interviews': 'Интервью',
            'events': 'Событие',
            'merch': 'Мерч'
        };
        news = news.filter(n => n.category === filterMap[filter]);
    }

    container.innerHTML = news.map(item => `
        <div class="news-card group cursor-pointer" onclick="window.location.href='article.html?id=${item.id}'">
            <div class="relative rounded-xl overflow-hidden aspect-[4/3] mb-4">
                <span class="badge absolute top-4 left-4 bg-black text-white text-xs font-bold px-3 py-1 rounded-full uppercase">${item.category}</span>
                <img src="" data-src="${item.image}" width="400" height="300" class="w-full h-full object-cover"
                     onerror="this.onerror=null; this.src=PlaceholderGenerator.generateError(400, 300)">
            </div>
            <p class="text-xs text-gray-500 mb-2">${item.date}</p>
            <h3 class="text-xl font-bold mb-2 group-hover:opacity-70 transition">${item.title}</h3>
            <p class="text-gray-600 text-sm line-clamp-2">${item.excerpt}</p>
        </div>
    `).join('');

    refreshLazyLoading();
}

if (window.location.pathname.includes('news')) {
    const savedFilter = StorageManager.loadNewsFilter();
    renderNews(savedFilter);

    document.querySelectorAll('.filter-btn').forEach(btn => {
        if (btn.dataset.filter === savedFilter) {
            btn.classList.add('active');
        }

        btn.addEventListener('click', () => {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const filter = btn.dataset.filter || 'all';
            StorageManager.saveNewsFilter(filter);
            renderNews(filter);
        });
    });
}

        function renderProducts(filter = 'all') {
            const grid = document.getElementById('products-grid');
            let filtered = products;
            
            if (filter === 'bestseller') {
                filtered = products.filter(p => p.badge2 === 'Хит');
            } else if (filter === 'music') {
                filtered = products.filter(p => p.category === 'music');
            } else if (filter === 'clothing') {
                filtered = products.filter(p => p.category === 'clothing');
            }
            
            grid.innerHTML = filtered.map(product => `
                <div class="product-card group" data-category="${product.category}">
                    <a href="product.html?id=${product.id}" class="block">
                        <div class="relative bg-gray-100 rounded-lg overflow-hidden aspect-square mb-4">
                            <span class="badge absolute top-3 left-3 ${product.badgeClass} text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">${product.badge}</span>
                            ${product.badge2 ? `<span class="badge absolute ${product.badge2Class} text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">${product.badge2}</span>` : ''}
                            ${product.saleBadge ? `<span class="badge absolute ${product.saleClass} text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">${product.saleBadge}</span>` : ''}
                            <img src="${product.image}" alt="${product.name}" 
                                 class="product-image w-full h-full object-cover"
                                 loading="lazy"
                                 onerror="this.src='https://via.placeholder.com/400x400/f3f4f6/000000?text=EMPIRE'">
                        </div>
                        <h3 class="font-semibold text-sm mb-1 group-hover:opacity-70 transition">${product.name}</h3>
                        <p class="text-gray-500 text-sm font-medium">
                            ${product.oldPrice ? `<span class="line-through text-gray-400 mr-1">$${product.oldPrice}${product.period}</span>` : ''}
                            <span class="${product.saleBadge ? 'text-red-600' : ''}">$${product.price}${product.period}</span>
                        </p>
                    </a>
                </div>
            `).join('');
        }

        document.querySelectorAll('.category-pill').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.category-pill').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                renderProducts(btn.dataset.filter);
            });
        });

        const searchOverlay = document.getElementById('search-overlay');
        const searchInput = document.getElementById('search-input');
        const searchResults = document.getElementById('search-results');

        document.getElementById('search-btn').addEventListener('click', () => {
            searchOverlay.classList.add('active');
            searchInput.focus();
        });

        document.getElementById('close-search').addEventListener('click', () => {
            searchOverlay.classList.remove('active');
        });

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase();
            if (!query) { searchResults.innerHTML = ''; return; }
            
            const found = products.filter(p => p.name.toLowerCase().includes(query));
            searchResults.innerHTML = found.length ? found.map(p => `
                <a href="product.html?id=${p.id}" class="flex items-center gap-4 p-4 hover:bg-white/10 rounded-lg transition">
                    <img src="${p.image}" class="w-12 h-12 rounded object-cover">
                    <div>
                        <div class="text-white font-medium">${p.name}</div>
                        <div class="text-gray-400 text-sm">$${p.price}${p.period}</div>
                    </div>
                </a>
            `).join('') : '<p class="text-gray-400 text-center">Ничего не найдено</p>';
        });

        function openModal(id) { document.getElementById(id).classList.add('active'); }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }
        window.openSubscribeModal = () => openModal('subscribe-modal');
        window.closeModal = closeModal;

        document.getElementById('subscribe-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const email = document.getElementById('subscribe-email').value;
            localStorage.setItem('empire_subscribed', JSON.stringify({ email, date: new Date().toISOString() }));
            showToast('Скидка 15% активирована! Проверьте email.', 'success');
            closeModal('subscribe-modal');
        });

        const video = document.querySelector('video');
        window.toggleMute = () => {
            video.muted = !video.muted;
            document.getElementById('mute-icon').innerHTML = video.muted 
                ? '<polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"></polygon><line x1=\"23\" y1=\"9\" x2=\"17\" y2=\"15\"></line><line x1=\"17\" y1=\"9\" x2=\"23\" y2=\"15\"></line>'
